        "word games",
        "letter values",
        "word score"
    ],
    "homepage": "https://apiverve.com/marketplace/scrabblescorer?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/scrabblescorer",
        "source": "https://github.com/apiverve/scrabblescorer-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
